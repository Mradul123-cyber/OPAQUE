<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme for Android 12+ (API 31+) which uses the new splash screen API -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <!-- Android 12+ specific splash screen attributes -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_android12</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>

        <!-- Standard attributes -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Normal theme remains the same -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>